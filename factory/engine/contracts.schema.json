    "why": {
     "type": "string"
    },
    "status": {
     "$ref": "#/$defs/ApprovalStatus"
    },
    "requested_at": {
     "type": "string"
    },
    "decided_at": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "decided_by": {
     "anyOf": [
      {
       "type": "string"
