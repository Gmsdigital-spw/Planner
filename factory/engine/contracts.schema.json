    "model": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "usage": {
     "anyOf": [
      {
       "$ref": "#/$defs/ModelUsage"
      },
      {
       "type": "null"
      }
     ]
