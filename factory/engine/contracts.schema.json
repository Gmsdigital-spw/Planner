  "IntegrationHealth": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "state": {
     "$ref": "#/$defs/IntegrationState"
    },
    "last_ok_at": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "last_error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
