    "validation": {
     "type": "object"
    },
    "output_ref": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "error": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "error_class": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "recovery": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "heartbeat_at": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "runner": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "id",
    "task_id",
    "agent_id",
    "attempt",
    "started_at"
   ],
   "additionalProperties": false
  },
  "Approval": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "task_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "capability": {
     "$ref": "#/$defs/Capability"
    },
    "title": {
     "type": "string"
