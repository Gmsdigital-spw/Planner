      {
       "type": "null"
      }
     ]
    },
    "cost": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "risk": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "id",
    "task_id",
    "capability",
    "title",
    "why"
   ],
   "additionalProperties": false
  },
  "AuditEvent": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string"
    },
    "at": {
     "type": "string"
    },
    "who": {
     "type": "string"
    },
    "action": {
     "type": "string"
    },
    "subject": {
     "type": "string"
    },
    "detail": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "at",
    "who",
    "action",
    "subject"
   ],
   "additionalProperties": false
  },
  "FileRef": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string"
    },
    "sha256": {
     "type": "string"
    },
    "bytes": {
     "type": "integer"
    },
    "format": {
     "type": "string"
    }
   },
   "required": [
    "path",
    "sha256",
    "bytes",
