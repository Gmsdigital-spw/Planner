    "version": {
     "type": "integer"
    },
    "created_at": {
     "type": "string"
    },
    "files": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/FileRef"
     }
    },
    "format": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "lane": {
