     "start": 1},
    {"text": "So I handed him the controller.",
     "clip": {"url": "https://videos.pexels.com/video-files/8128420/8128420-hd_1080_1920_25fps.mp4", "credit": "Alena Darmel", "page": "https://www.pexels.com/video/a-man-holding-a-game-controller-8128420/"}},
    {"text": "Thirty seconds.",
